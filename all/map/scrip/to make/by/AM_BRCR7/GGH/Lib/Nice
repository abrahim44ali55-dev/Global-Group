-- ======================================================================
-- [ 1. الرابط الشامل والديناميكي لتعريب محرك روبلوكس بالكامل ]
-- ======================================================================

-- قاموس ترجمة الكلمات المفتاحية للخصائص والميثودز والأحداث (يغطي كل كائنات روبلوكس)
local قاموس_المصطلحات = {
	-- الخصائص العامة لكل الكائنات (Parts, UI, Players...)
	الاسم = "Name", الحجم = "Size", الموقع = "Position", الأب = "Parent", 
	المرساة = "Anchored", الشفافية = "Transparency", اللون = "Color",
	النوع = "ClassName", القيمة = "Value", النص = "Text", مرئي = "Visible",
	الصحة = "Health", أقصى_صحة = "MaxHealth", السرعة = "WalkSpeed", قوة_القفز = "JumpPower",
	
	-- الميثودز (الوظائف)
	تدمير = "Destroy", ابحث_عن_ابن = "FindFirstChild", انتظر_الابن = "WaitForChild",
	احصل_على_الأبناء = "GetChildren", احصل_على_المتحدرين = "GetDescendants",
	استنساخ = "Clone", تشغيل = "Play", إيقاف = "Stop", اطلاق_عن_بعد = "FireServer",
	
	-- الأحداث (Events)
	عند_اللمس = "Touched", عند_انتهاء_اللمس = "TouchEnded", عند_الدخول = "PlayerAdded",
	عند_المغادرة = "PlayerRemoving", عند_الولادة = "CharacterAdded", عند_الموت = "Died",
	عند_الضغط = "MouseButton1Click", عند_الاستلام = "OnServerEvent"
}

-- محرك التعريب الذكي العائم (يعرب أي كائن يدخل فيه تلقائياً)
local function تعريب_ديناميكي(الكائن_الأصلي)
	if not الكائن_الأصلي أو (typeof(الكائن_الأصلي) ~= "Instance" ونوع(الكائن_الأصلي) ~= "RBXScriptSignal") then 
		return الكائن_الأصلي 
	end
	
	return setmetatable({}, {
		__index = function(_, المفتاح العربي)
			-- تحويل المفتاح العربي إلى إنجليزي
			local المفتاح_الأصلي = قاموس_المصطلحات[المفتاح_العربي] or المفتاح_العربي
			local القيمة = الكائن_الأصلي[المفتاح_الأصلي]
			
			-- إذا كانت القيمة دالة (Method) نقوم بتشغيلها مع تحويل الآرغومنتات
			if typeof(القيمة) == "function" then
				return function(_, ...)
					local args = {...}
					for i, v in ipairs(args) do
						if typeof(v) == "table" and v._raw then args[i] = v._raw end
					end
					-- تشغيل الدالة الأصلية وإرجاع النتيجة معربة
					return تعريب_ديناميكي(قيمة(الكائن_الأصلي, unpack(args)))
				end
			end
			
			-- إرجاع القيمة معربة (لو كانت كائن أو حدث)
			return تعريب_ديناميكي(القيمة)
		end,
		
		__newindex = function(_, المفتاح_العربي, القيمة)
			local المفتاح_الأصلي = قاموس_المصطلحات[المفتاح_العربي] or المفتاح_العربي
			if typeof(القيمة) == "table" and القيمة._raw then
				الكائن_الأصلي[المفتاح_الأصلي] = القيمة._raw
			else
				الكائن_الأصلي[المفتاح_الأصلي] = القيمة
			end
		end,
		_raw = الكائن_الأصلي -- للاحتفاظ بالكائن الأصلي غير المعرب عند الحاجة
	})
end

-- تغليف البيئة الأساسية لروبلوكس بالكامل لتصبح عربية
local البيئة_العربية = {
	اطبع = print, تحذير = warn, خطأ = error, انتظر = task.wait, تفرع = task.spawn,
	جديد = Instance.new, متجه3 = Vector3.new, ألوان = Color3.fromRGB, لون_طابوق = BrickColor.new,
	-- تعريب اللعبة ومساحة العمل بالكامل ديناميكياً!
	اللعبة = تعريب_ديناميكي(game),
	العالم = تعريب_ديناميكي(workspace)
}

-- ======================================================================
-- [ 2. مفسر ومترجم الهيكل (العربي -> Luau) ]
-- ======================================================================
local function تشغيل_السيستم_العربي(الكود_العربي)
	local كود_مترجم = الكود_العربي
	
	local الكلمات_المفتاحية = {
		["متغير"] = "local", ["دالة"] = "function", ["لو"] = "if", 
		["إذن"] = "then", ["وإلا"] = "else", ["نهاية"] = "end", 
		["صح"] = "true", ["خطأ_منطقي"] = "false", ["طالما"] = "while", 
		["كرر"] = "do", ["رجع"] = "return"
	}
	
	for عربي, إنجليزي in pairs(الكلمات_المفتاحية) do
		كود_مترجم = string.gsub(kود_مترجم, "([%s%c%p])" .. عربي .. "([%s%c%p])", "%1" .. إنجليزي .. "%2")
		كود_مترجم = string.gsub(kود_مترجم, "^" .. عربي .. "([%s%c%p])", إنجليزي .. "%1")
	end
	
	local دالة_التشغيل, رسالة_الخطأ = loadstring(كود_مترجم)
	if دالة_التشغيل then
		setfenv(دالة_التشغيل, setmetatable(البيئة_العربية, {__index = getfenv()}))
		local نجاح, الخطأ = pcall(دالة_التشغيل)
		if not نجاح then warn("[خطأ تشغيل]: " .. tostring(الخطأ)) end
	else
		warn("[خطأ قواعد]: " .. tostring(رسالة_الخطأ))
	end
end

