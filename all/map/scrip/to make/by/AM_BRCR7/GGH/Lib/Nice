local محرك_التعريب = {}

-- قاموس المصطلحات الشامل للهيكل والخصائص والميثودز
local قاموس_المصطلحات = {
	["متغير"] = "local", ["دالة"] = "function", ["لو"] = "if", 
	["إذن"] = "then", ["وإلا"] = "else", ["نهاية"] = "end", 
	["صح"] = "true", ["خطأ"] = "false", ["رجع"] = "return",

	اطبع = "print", تحذير = "warn", خطأ_برمجي = "error", انتظر = "wait", 
	جديد = "Instance.new", متجه3 = "Vector3.new", ألوان = "Color3.fromRGB",
	اللعبة = "game", العالم = "workspace", مساحة_العمل = "workspace",

	الاسم = "Name", الحجم = "Size", الموقع = "Position", الأب = "Parent", 
	السرعة = "WalkSpeed", الصحة = "Health", اللاعبين = "Players", 
	الشخصية = "Character", ابحث_عن_ابن = "FindFirstChild", انتظر_الابن = "WaitForChild",
	تدمير = "Destroy", عند_الدخول = "PlayerAdded", عند_الولادة = "CharacterAdded",
	
	-- تعريب ميثودز وخصائص مكتبة الواجهات Rayfield
	صنع_علامة_تبويب = "CreateTab", صنع_زر = "CreateButton", العنوان = "Name",
	عنوان_التحميل = "LoadingTitle", عنوان_فرعي = "LoadingSubtitle",
	حفظ_الإعدادات = "ConfigurationSaving", تفعيل = "Enabled", نداء_خلفي = "Callback"
}

-- جدول تحويل الأرقام الشرقية/العربية إلى الأرقام الغربية البرمجية
local قاموس_الأرقام = {
	["٠"] = "0", ["١"] = "1", ["٢"] = "2", ["٣"] = "3", ["٤"] = "4",
	["٥"] = "5", ["٦"] = "6", ["٧"] = "7", ["٨"] = "8", ["٩"] = "9"
}

-- محرك الـ Metatable الديناميكي لتغليف الكائنات
local function تعريب_ديناميكي(الكائن_الأصلي)
	if not الكائن_الأصلي أو (typeof(الكائن_الأصلي) ~= "Instance" ونوع(الكائن_الأصلي) ~= "table") then 
		return الكائن_الأصلي 
	end
	
	return setmetatable({}, {
		__index = function(_, المفتاح_العربي)
			local المفتاح_الأصلي = قاموس_المصطلحات[المفتاح_العربي] or المفتاح_العربي
			local القيمة = الكائن_الأصلي[المفتاح_الأصلي]
			
			if typeof(القيمة) == "function" then
				return function(_, ...)
					local args = {...}
					for i, v in ipairs(args) do
						if typeof(v) == "table" then
							local جرد_مترجم = {}
							for ك، ص في pairs(v) do
								local مفتاح_أصل = قاموس_المصطلحات[ك] or ك
								جرد_مترجم[مفتاح_أصل] = (typeof(ص) == "table" و ص._raw) or ص
							end
							args[i] = جرد_مترجم
						end
					end
					return تعريب_ديناميكي(قيمة(الكائن_الأصلي, unpack(args)))
				end
			end
			return تعريب_ديناميكي(القيمة)
		end,
		
		__newindex = function(_, المفتاح_العربي, القيمة)
			local المفتاح_الأصلي = قاموس_المصطلحات[المفتاح_العربي] or المفتاح_العربي
			الكائن_الأصلي[المفتاح_الأصلي] = (typeof(القيمة) == "table" و القيمة._raw) or القيمة
		end,
		_raw = الكائن_الأصلي
	})
end

-- جلب مكتبة GGH الأصلية
local رابط_المكتبة = "https://raw.githubusercontent.com/abrahim44ali55-dev/Global-Group/refs/heads/main/all/map/scrip/to%20make/by/AM_BRCR7/GGH/Lib/Nice"
local دالة_المكتبة = loadstring(game:HttpGet(رابط_المكتبة))()

local البيئة_العربية = {
	اطبع = print, تحذير = warn, انتظر = task.wait,
	اللعبة = تعريب_ديناميكي(game), العالم = تعريب_ديناميكي(workspace),
	أنا = تعريب_ديناميكي(game:GetService("Players").LocalPlayer)
}

البيئة_العربية.مكتبة_الواجهات = setmetatable({}, {
	__index = function(_, المفتاح)
		if المفتاح == "صنع_نافذة" then
			return function(_, خيارات)
				local نافذة_أصلية = دالة_المكتبة:CreateWindow({
					Name = خيارات.الاسم or خيارات.العنوان,
					LoadingTitle = خيارات.عنوان_التحميل,
					LoadingSubtitle = خيارات.عنوان_فرعي,
					ConfigurationSaving = { Enabled = false }
				})
				return تعريب_ديناميكي(نافذة_أصلية)
			end
		end
	end
})

-- دالة تشغيل السكربت مع معالجة الهيكل والكلمات والأرقام تلقائياً
function محرك_التعريب.تشغيل(الكود_العربي)
	local كود_مترجم = الكود_العربي
	
	-- 1. تحويل كافة الأرقام العربية/الهندية (١، ٢، ٣...) إلى أرقام برمجية
	for رقم_عربي, رقم_برمجي في pairs(قاموس_الأرقام) do
		كود_مترجم = string.gsub(كود_مترجم, رقم_عربي, رقم_برمجي)
	end
	
	-- 2. تحويل الكلمات الهيكلية البرمجية
	local الكلمات_الهيكلية = {
		["متغير"] = "local", ["دالة"] = "function", ["لو"] = "if", 
		["إذن"] = "then", ["وإلا"] = "else", ["نهاية"] = "end", 
		["صح"] = "true", ["خطأ"] = "false", ["رجع"] = "return"
	}
	for عربي, إنجليزي في pairs(الكلمات_الهيكلية) do
		كود_مترجم = string.gsub(كود_مترجم, "([%s%c%p])" .. عربي .. "([%s%c%p])", "%1" .. إنجليزي .. "%2")
		كود_مترجم = string.gsub(كود_مترجم, "^" .. عربي .. "([%s%c%p])", إنجليزي .. "%1")
	end
	
	local دالة_التشغيل = loadstring(كود_مترجم)
	if دالة_التشغيل then
		setfenv(دالة_التشغيل, setmetatable(البيئة_العربية, {__index = getfenv()}))
		pcall(دالة_التشغيل)
	end
end

return محرك_التعريب
