local محرك_التعريب = {}

-- قاموس الكلمات الهيكلية والخصائص والميثودز
local قاموس_المصطلحات = {
	["متغير"] = "local", ["دالة"] = "function", ["لو"] = "if", 
	["إذن"] = "then", ["وإلا"] = "else", ["نهاية"] = "end", 
	["صح"] = "true", ["خطأ"] = "false", ["رجع"] = "return",

	اطبع = "print", تحذير = "warn", خطأ_برمجي = "error", انتظر = "wait", 
	اللعبة = "game", العالم = "workspace",

	الاسم = "Name", السرعة = "WalkSpeed", الصحة = "Health", 
	اللاعبين = "Players", الشخصية = "Character",
	ابحث_عن_ابن = "FindFirstChild", انتظر_الابن = "WaitForChild"
}

-- قاموس تحويل الأرقام العربية/الشرقية تلقائياً
local قاموس_الأرقام = {
	["٠"] = "0", ["١"] = "1", ["٢"] = "2", ["٣"] = "3", ["٤"] = "4",
	["٥"] = "5", ["٦"] = "6", ["٧"] = "7", ["٨"] = "8", ["٩"] = "9"
}

-- محرك الـ Metatable الديناميكي لتغليف الكائنات برمجياً داخل روبلوكس
local function تعريب_ديناميكي(الكائن_الأصلي)
	if not الكائن_الأصلي أو (typeof(الكائن_الأصلي) ~= "Instance" ونوع(الكائن_الأصلي) ~= "table") then 
		return الكائن_الأصلي 
	end
	
	return setmetatable({}, {
		__index = function(_, المفتاح_العربي)
			local المفتاح_الأصلي = قاموس_المصطلحات[المفتاح_العربي] or المفتاح_العربي
			local القيمة = الكائن_الأصلي[المفتاح_الأصلي]
			
			if typeof(القيمة) == "function" then
				return function(_, ...)
					local args = {...}
					for i, v في ipairs(args) do
						if typeof(v) == "table" وعنده_أصل then args[i] = v._raw end
					end
					return تعريب_ديناميكي(قيمة(الكائن_الأصلي, unpack(args)))
				end
			end
			return تعريب_ديناميكي(القيمة)
		end,
		
		__newindex = function(_, المفتاح_العربي, القيمة)
			local المفتاح_الأصلي = قاموس_المصطلحات[المفتاح_العربي] or المفتاح_العربي
			if typeof(القيمة) == "table" وعنده_أصل then
				الكائن_الأصلي[المفتاح_الأصلي] = القيمة._raw
			else
				الكائن_الأصلي[المفتاح_الأصلي] = القيمة
			end
		end,
		_raw = الكائن_الأصلي
	})
end

-- بناء بيئة التشغيل المستقلة والمعربة
local البيئة_العربية = {
	اطبع = print, تحذير = warn, انتظر = task.wait,
	اللعبة = تعريب_ديناميكي(game),
	العالم = تعريب_ديناميكي(workspace),
	أنا = تعريب_ديناميكي(game:GetService("Players").LocalPlayer)
}

-- دالة تشغيل الأكواد المترجمة
function محرك_التعريب.تشغيل(الكود_العربي)
	local كود_مترجم = الكود_العربي
	
	-- 1. تحويل كافة الأرقام العربية
	for رقم_عربي, رقم_برمجي في pairs(قاموس_الأرقام) do
		كود_مترجم = string.gsub(كود_مترجم, رقم_عربي, رقم_برمجي)
	end
	
	-- 2. تحويل الكلمات الهيكلية للغة لوا
	local الكلمات_الهيكلية = {
		["متغير"] = "local", ["دالة"] = "function", ["لو"] = "if", 
		["إذن"] = "then", ["وإلا"] = "else", ["نهاية"] = "end", 
		["صح"] = "true", ["خطأ"] = "false", ["رجع"] = "return"
	}
	for عربي, إنجليزي في pairs(الكلمات_الهيكلية) do
		كود_مترجم = string.gsub(كود_مترجم, "([%s%c%p])" .. عربي .. "([%s%c%p])", "%1" .. إنجليزي .. "%2")
		كود_مترجم = string.gsub(kود_مترجم, "^" .. عربي .. "([%s%c%p])", إنجليزي .. "%1")
	end
	
	local دالة_التشغيل، رسالة_الخطأ = loadstring(كود_مترجم)
	if دالة_التشغيل then
		setfenv(دالة_التشغيل, setmetatable(البيئة_العربية, {__index = getfenv()}))
		local نجاح، الخطأ = pcall(دالة_التشغيل)
		if not نجاح then warn("[خطأ تشغيل]: " .. tostring(الخطأ)) end
	else
		warn("[خطأ قواعد]: " .. tostring(رسالة_الخطأ))
	end
end

return محرك_التعريب
